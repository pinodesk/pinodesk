app.name=${project.name}
app.version=${project.version}

# Please change based on your development OS, must be one of: windows, macos, linux-deb, linux-rpm
release.platform=windows

# JDBC configs
jdbc.url=jdbc:h2:~/.pinodesk-dev/db/pinodesk;MODE=MySQL;DATABASE_TO_LOWER=TRUE;DB_CLOSE_ON_EXIT=FALSE;CIPHER=AES
jdbc.user=sa
jdbc.password=sa
jdbc.driver=org.h2.Driver

sequel.jdbc.formatsql=true

pinodesk.api.base_url=http://localhost:8080
pinodesk.api.key=xxx

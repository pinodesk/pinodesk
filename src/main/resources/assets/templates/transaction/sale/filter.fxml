<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import java.lang.String?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>
<VBox fx:id="contentPane" prefWidth="774" style="-fx-background-color: white; -fx-font-size: 13px;" stylesheets="@../../../css/pinodesk.css" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.pinodesk.controller.transaction.sale.SaleFilterController">
    <Label text="%lbl_title_filter_sales" style="-fx-font-size: 24px;">
        <padding><Insets top="5" bottom="5" left="10" right="10" /></padding>
    </Label>
    <VBox spacing="10" style="-fx-border-color: #bebebe;">
        <padding><Insets top="10" right="10" bottom="10" left="10" /></padding>
        <VBox.margin><Insets left="10" right="10" bottom="10" /></VBox.margin>
        <HBox spacing="10">
            <VBox  spacing="5" prefWidth="0" minWidth="0" HBox.hgrow="ALWAYS"><Label text="%lbl_invoice_number" /><TextField fx:id="tfInvoiceNumber" maxWidth="Infinity" styleClass="input-primary" /></VBox>
            <VBox  spacing="5" prefWidth="0" minWidth="0" HBox.hgrow="ALWAYS"><Label text="%lbl_customer" /><TextField fx:id="tfCustomer" maxWidth="Infinity" styleClass="input-primary" editable="false"/></VBox>
            <VBox fx:id="vboxDoctor" spacing="5" prefWidth="0" minWidth="0" HBox.hgrow="ALWAYS"><Label text="%lbl_doctor" /><TextField fx:id="tfDoctor" maxWidth="Infinity" styleClass="input-primary" editable="false"/></VBox>
        </HBox>
        <HBox spacing="10">
            <VBox  spacing="5" prefWidth="0" minWidth="0" HBox.hgrow="ALWAYS"><Label text="%lbl_payment_status" /><ComboBox fx:id="cbPaymentStatus" maxWidth="Infinity" styleClass="combo-box-primary" /></VBox>
            <VBox  spacing="5" prefWidth="0" minWidth="0" HBox.hgrow="ALWAYS"><Label text="%lbl_payment_method" /><ComboBox fx:id="cbPaymentMethod" maxWidth="Infinity" styleClass="combo-box-primary" /></VBox>
        </HBox>
        <HBox spacing="10">
            <VBox  spacing="5" prefWidth="0" minWidth="0" HBox.hgrow="ALWAYS"><Label text="%lbl_created_date_min" /><AnchorPane><DatePicker fx:id="dpCreatedDateMin" editable="false" maxWidth="Infinity" styleClass="input-primary" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" />
                <Button prefWidth="25" prefHeight="25" textFill="WHITE" AnchorPane.rightAnchor="2" AnchorPane.topAnchor="2" AnchorPane.bottomAnchor="2"><graphic><FontAwesomeIconView glyphName="TIMES" fill="WHITE" size="13" /></graphic><styleClass><String fx:value="btn-secondary" /><String fx:value="date-picker-clear-btn" /></styleClass></Button></AnchorPane></VBox>
            <VBox  spacing="5" prefWidth="0" minWidth="0" HBox.hgrow="ALWAYS"><Label text="%lbl_created_date_max" /><AnchorPane><DatePicker fx:id="dpCreatedDateMax" editable="false" maxWidth="Infinity" styleClass="input-primary" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" />
                <Button prefWidth="25" prefHeight="25" textFill="WHITE" AnchorPane.rightAnchor="2" AnchorPane.topAnchor="2" AnchorPane.bottomAnchor="2"><graphic><FontAwesomeIconView glyphName="TIMES" fill="WHITE" size="13" /></graphic><styleClass><String fx:value="btn-secondary" /><String fx:value="date-picker-clear-btn" /></styleClass></Button></AnchorPane></VBox>
            <VBox  spacing="5" prefWidth="0" minWidth="0" HBox.hgrow="ALWAYS"><Label text="%lbl_due_date_min" /><AnchorPane><DatePicker fx:id="dpDueDateMin" editable="false" maxWidth="Infinity" styleClass="input-primary" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" />
                <Button prefWidth="25" prefHeight="25" textFill="WHITE" AnchorPane.rightAnchor="2" AnchorPane.topAnchor="2" AnchorPane.bottomAnchor="2"><graphic><FontAwesomeIconView glyphName="TIMES" fill="WHITE" size="13" /></graphic><styleClass><String fx:value="btn-secondary" /><String fx:value="date-picker-clear-btn" /></styleClass></Button></AnchorPane></VBox>
            <VBox  spacing="5" prefWidth="0" minWidth="0" HBox.hgrow="ALWAYS"><Label text="%lbl_due_date_max" /><AnchorPane><DatePicker fx:id="dpDueDateMax" editable="false" maxWidth="Infinity" styleClass="input-primary" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" />
                <Button prefWidth="25" prefHeight="25" textFill="WHITE" AnchorPane.rightAnchor="2" AnchorPane.topAnchor="2" AnchorPane.bottomAnchor="2"><graphic><FontAwesomeIconView glyphName="TIMES" fill="WHITE" size="13" /></graphic><styleClass><String fx:value="btn-secondary" /><String fx:value="date-picker-clear-btn" /></styleClass></Button></AnchorPane></VBox>
        </HBox>
        <HBox spacing="10">
            <VBox  spacing="5" prefWidth="0" minWidth="0" HBox.hgrow="ALWAYS"><Label text="%lbl_total_product_min" /><TextField fx:id="tfTotalProductMin" maxWidth="Infinity" styleClass="input-primary" /></VBox>
            <VBox  spacing="5" prefWidth="0" minWidth="0" HBox.hgrow="ALWAYS"><Label text="%lbl_total_product_max" /><TextField fx:id="tfTotalProductMax" maxWidth="Infinity" styleClass="input-primary" /></VBox>
            <VBox  spacing="5" prefWidth="0" minWidth="0" HBox.hgrow="ALWAYS"><Label text="%lbl_total_payment_min" /><TextField fx:id="tfTotalPaymentMin" maxWidth="Infinity" styleClass="input-primary" /></VBox>
            <VBox  spacing="5" prefWidth="0" minWidth="0" HBox.hgrow="ALWAYS"><Label text="%lbl_total_payment_max" /><TextField fx:id="tfTotalPaymentMax" maxWidth="Infinity" styleClass="input-primary" /></VBox>
        </HBox>
    </VBox>
    <AnchorPane style="-fx-background-color: #ececec;">
        <HBox spacing="1" AnchorPane.topAnchor="10" AnchorPane.bottomAnchor="10" AnchorPane.rightAnchor="10">
            <Button fx:id="btnCancel" minWidth="73" text="%btn_cancel" textFill="WHITE" onAction="#onActionBtnCancel" styleClass="btn-secondary" />
            <Button fx:id="btnReset" minWidth="73" text="%btn_reset" textFill="WHITE" onAction="#onActionBtnReset" styleClass="btn-secondary" />
            <Button fx:id="btnFilter" minWidth="73" text="%btn_filter" textFill="WHITE" onAction="#onActionBtnFilter" styleClass="btn-primary" />
        </HBox>
    </AnchorPane>
</VBox>

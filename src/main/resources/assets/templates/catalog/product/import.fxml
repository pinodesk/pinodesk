<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox fx:id="contentPane" prefWidth="600.0" style="-fx-background-color: white;" stylesheets="@../../../css/pinodesk.css" xmlns="http://javafx.com/javafx/15.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pinodesk.controller.catalog.product.ProductImportController">
   <children>
      <AnchorPane prefWidth="774.0">
         <children>
            <Label layoutX="14.0" layoutY="8.0" style="-fx-background-color: white;" text="%lbl_title_import_products" AnchorPane.leftAnchor="10.0" AnchorPane.topAnchor="0.0">
               <font>
                  <Font size="24.0" />
               </font>
               <padding>
                  <Insets bottom="5.0" top="5.0" />
               </padding>
            </Label>
         </children>
      </AnchorPane>
      <VBox fx:id="vboxContent" spacing="10.0" style="-fx-border-color: #bebebe #bebebe;">
         <children>
            <HBox spacing="10.0">
               <children>
                  <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label text="%lbl_file">
                           <font>
                              <Font size="13.0" />
                           </font>
                        </Label>
                        <TextField fx:id="tfFile" editable="false" styleClass="input-primary">
                           <font>
                              <Font size="13.0" />
                           </font>
                        </TextField>
                     </children>
                  </VBox>
               </children>
            </HBox>
            <HBox spacing="10.0">
               <children>
                  <VBox spacing="5.0">
                     <children>
                        <Button fx:id="btnDownload" minWidth="73.0" mnemonicParsing="false" onAction="#onActionBtnDownload" styleClass="btn-primary" text="%btn_download_template" textFill="WHITE" />
                        <Label text="%lbl_info_template" wrapText="true">
                           <font>
                              <Font size="13.0" />
                           </font>
                        </Label>
                     </children>
                  </VBox>
                  <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label>
                           <font>
                              <Font size="13.0" />
                           </font>
                        </Label>
                     </children>
                  </VBox>
               </children>
            </HBox>
         </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
         <VBox.margin>
            <Insets bottom="10.0" left="10.0" right="10.0" />
         </VBox.margin>
      </VBox>
      <AnchorPane prefWidth="774.0" style="-fx-background-color: #ececec;" VBox.vgrow="NEVER">
         <children>
            <HBox alignment="CENTER_LEFT" layoutX="398.0" layoutY="10.0" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
               <children>
                  <HBox fx:id="hboxButtons" alignment="CENTER_RIGHT" spacing="1.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Button fx:id="btnCancel" minWidth="73.0" mnemonicParsing="false" onAction="#onActionBtnCancel" styleClass="btn-secondary" text="%btn_cancel" textFill="WHITE" />
                        <Button fx:id="btnImport" minWidth="73.0" mnemonicParsing="false" onAction="#onActionBtnImport" styleClass="btn-primary" text="%btn_import" textFill="WHITE" />
                     </children>
                  </HBox>
               </children>
            </HBox>
         </children>
      </AnchorPane>
   </children>
</VBox>

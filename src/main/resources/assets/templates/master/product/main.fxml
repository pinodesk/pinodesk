<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="623.0" prefWidth="774.0" style="-fx-background-color: transparent;" stylesheets="@../../../css/stoready-desktop.css" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="stoready.desktop.controller.product.ProductMainController">
   <children>
      <AnchorPane prefWidth="774.0">
         <children>
            <Label layoutX="14.0" layoutY="8.0" style="-fx-background-color: white;" text="%lbl_title_products" AnchorPane.leftAnchor="10.0" AnchorPane.topAnchor="0.0">
               <font>
                  <Font size="24.0" />
               </font>
               <padding>
                  <Insets bottom="4.0" top="4.0" />
               </padding>
            </Label>
         </children>
      </AnchorPane>
      <HBox>
         <VBox.margin>
            <Insets left="10.0" right="10.0" top="10.0" />
         </VBox.margin>
         <children>
            <HBox alignment="CENTER_LEFT" spacing="5.0" style="-fx-border-color: #009c7c;" HBox.hgrow="NEVER">
               <children>
                  <Label fx:id="lblRows" text="0" textFill="#009c7c" />
                  <Label text="%lbl_products" textFill="#009c7c" />
               </children>
               <padding>
                  <Insets left="10.0" right="10.0" />
               </padding>
            </HBox>
            <HBox alignment="TOP_RIGHT" spacing="1.0" HBox.hgrow="ALWAYS">
               <children>
                  <Button fx:id="btnImport" mnemonicParsing="false" onAction="#onActionBtnImport" prefHeight="30.0" prefWidth="73.0" styleClass="btn-primary" text="%btn_import" textFill="WHITE" visible="false">
                     <font>
                        <Font size="13.0" />
                     </font>
                  </Button>
                  <Button fx:id="btnFilter" minWidth="73.0" mnemonicParsing="false" onAction="#onActionBtnFilter" prefHeight="30.0" prefWidth="73.0" styleClass="btn-secondary" text="%btn_filter" textFill="WHITE">
                     <font>
                        <Font size="13.0" />
                     </font>
                  </Button>
                  <Button fx:id="btnRemove" minWidth="73.0" mnemonicParsing="false" onAction="#onActionBtnRemove" prefHeight="30.0" prefWidth="73.0" styleClass="btn-danger" text="%btn_remove" textFill="WHITE">
                     <font>
                        <Font size="13.0" />
                     </font>
                  </Button>
                  <Button fx:id="btnAdd" mnemonicParsing="false" onAction="#onActionBtnAdd" prefHeight="30.0" prefWidth="73.0" styleClass="btn-primary" text="%btn_add" textFill="WHITE">
                     <font>
                        <Font size="13.0" />
                     </font>
                  </Button>
               </children>
            </HBox>
         </children>
      </HBox>
      <TableView fx:id="tblProduct" maxHeight="1.7976931348623157E308" prefWidth="754.0" style="-fx-font-size: 13px;" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="colName" minWidth="-Infinity" prefWidth="300.0" text="%lbl_name" />
            <TableColumn fx:id="colQuantity" minWidth="-Infinity" prefWidth="100.0" text="%lbl_quantity" />
            <TableColumn fx:id="colUnit" minWidth="-Infinity" prefWidth="100.0" text="%lbl_unit" />
            <TableColumn fx:id="colCategory" minWidth="-Infinity" prefWidth="200.0" text="%lbl_category" />
            <TableColumn fx:id="colGeneralSellingPrice" minWidth="-Infinity" prefWidth="200.0" text="%lbl_general_selling_price" />
            <TableColumn fx:id="colPrescriptionSellingPrice" minWidth="-Infinity" prefWidth="200.0" text="%lbl_prescription_selling_price" />
            <TableColumn fx:id="colAverageBuyingPrice" minWidth="-Infinity" prefWidth="200.0" text="%lbl_average_buying_price" />
          <TableColumn fx:id="colCode" minWidth="-Infinity" prefWidth="150.0" text="%lbl_code" />
            <TableColumn fx:id="colBarcode" minWidth="-Infinity" prefWidth="150.0" text="%lbl_barcode" />
            <TableColumn fx:id="colClosestExpiry" minWidth="-Infinity" prefWidth="150.0" text="%lbl_closest_expiry" />
            <TableColumn fx:id="colStatus" minWidth="-Infinity" prefWidth="150.0" text="%lbl_status" />
            <TableColumn fx:id="colUpdatedAt" minWidth="-Infinity" prefWidth="150.0" text="%lbl_updated_at" />
        </columns>
         <VBox.margin>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </VBox.margin>
      </TableView>
   </children>
</VBox>

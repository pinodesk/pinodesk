<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?><?import javafx.scene.control.*?><?import javafx.scene.layout.*?><?import javafx.scene.text.Font?>
<VBox prefHeight="623.0" prefWidth="774.0" style="-fx-background-color: transparent;"
    stylesheets="@../../../css/pinodesk.css" xmlns="http://javafx.com/javafx/18"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.pinodesk.controller.settings.expensecategory.ExpenseCategoryMainController">
    <children>
        <AnchorPane prefWidth="774.0">
            <children>
                <Label layoutX="14.0" layoutY="8.0" style="-fx-background-color: white;"
                    text="%lbl_expense_categories" AnchorPane.leftAnchor="10.0"
                    AnchorPane.topAnchor="0.0">
                    <font>
                        <Font size="24.0" />
                    </font>
                    <padding>
                        <Insets bottom="5.0" top="5.0" />
                    </padding>
                </Label>
            </children>
        </AnchorPane>
        <HBox>
            <VBox.margin>
                <Insets left="10.0" right="10.0" top="10.0" />
            </VBox.margin>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="5.0" style="-fx-border-color: #009c7c;">
                    <children>
                        <Label fx:id="lblRows" text="0" textFill="#009c7c" />
                        <Label text="%lbl_expense_categories" textFill="#009c7c" />
                    </children>
                    <padding>
                        <Insets left="10.0" right="10.0" />
                    </padding>
                </HBox>
                <HBox alignment="TOP_RIGHT" spacing="1.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Button fx:id="btnFilter" minWidth="73.0" onAction="#onActionBtnFilter"
                            styleClass="btn-secondary" text="%btn_filter" textFill="WHITE" />
                        <Button fx:id="btnRemove" minWidth="73.0" onAction="#onActionBtnRemove"
                            styleClass="btn-danger" text="%btn_remove" textFill="WHITE" />
                        <Button fx:id="btnAdd" minWidth="73.0" onAction="#onActionBtnAdd"
                            styleClass="btn-primary" text="%btn_add" textFill="WHITE" />
                    </children>
                </HBox>
            </children>
        </HBox>
        <TableView fx:id="tblCategories" maxHeight="1.7976931348623157E308"
            style="-fx-font-size: 13px;" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colName" prefWidth="300.0" text="%lbl_expense_category_name" />
                <TableColumn fx:id="colStatus" prefWidth="120.0" text="%lbl_status" />
                <TableColumn fx:id="colCreatedAt" prefWidth="150.0" text="%lbl_created_at" />
                <TableColumn fx:id="colUpdatedAt" prefWidth="150.0" text="%lbl_updated_at" />
            </columns>
            <VBox.margin>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </VBox.margin>
        </TableView>
    </children>
</VBox>

<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog 
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog-ext
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd">
     
    <changeSet author="muhammad" id="0001">
        <createTable tableName="t_product">
            <column name="id" type="java.sql.Types.BIGINT" autoIncrement="true" >
                <constraints nullable="false" primaryKey="true" />
            </column>
            <column name="created_at" type="java.sql.Types.TIMESTAMP" >
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="java.sql.Types.TIMESTAMP" >
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="java.sql.Types.TIMESTAMP" />
            <!-- START model columns -->
            <column name="name" type="java.sql.Types.VARCHAR(256)" />
            <column name="code" type="java.sql.Types.VARCHAR(64)" >
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_t_product_code" />
            </column>
            <column name="price" type="java.sql.Types.DECIMAL" defaultValue="0" />
            <column name="quantity" type="java.sql.Types.INTEGER" defaultValue="0" />
            <!-- END model columns -->
        </createTable>
        <createIndex tableName="t_product" indexName="idx_t_product_code">
            <column name="code" />
        </createIndex>
        <insert tableName="t_product" >
            <column name="created_at" valueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_at" valueComputed="CURRENT_TIMESTAMP"/>
            <column name="name" value="Coki Coki 20" />
            <column name="code" value="0000001" />
            <column name="quantity" value="10" />
            <column name="price" value="3000" />
        </insert>

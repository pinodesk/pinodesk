<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog 
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog-ext
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.0.xsd">
     
    <changeSet author="muhammad" id="0001">
        <createTable tableName="t_unit">
            <column name="id" type="java.sql.Types.BIGINT" autoIncrement="true" >
                <constraints nullable="false" primaryKey="true" />
            </column>
            <column name="created_at" type="java.sql.Types.TIMESTAMP" >
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="java.sql.Types.TIMESTAMP" >
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="java.sql.Types.TIMESTAMP" />
            <!-- START model columns -->
            <column name="label" type="java.sql.Types.VARCHAR(32)" />
            <column name="name" type="java.sql.Types.VARCHAR(128)" >
                <constraints nullable="false"/>
            </column>
            <!-- END model columns -->
        </createTable>
        <loadData file="db/changelog/changeset/0001__create_initial_tables/t_unit.csv"
                  separator=","
                  tableName="t_unit" />

        <createTable tableName="t_language">
            <column name="id" type="java.sql.Types.BIGINT" autoIncrement="true" >
                <constraints nullable="false" primaryKey="true" />
            </column>
            <column name="created_at" type="java.sql.Types.TIMESTAMP" >
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="java.sql.Types.TIMESTAMP" >
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="java.sql.Types.TIMESTAMP" />
            <!-- START model columns -->
            <column name="code" type="java.sql.Types.VARCHAR(3)" >
                <constraints nullable="false"/>
            </column>
            <column name="name" type="java.sql.Types.VARCHAR(128)" >
                <constraints nullable="false"/>
            </column>
            <!-- END model columns -->
        </createTable>
        <loadData file="db/changelog/changeset/0001__create_initial_tables/t_language.csv"
                  separator=","
                  tableName="t_language" />

        <createTable tableName="t_product_category">
            <column name="id" type="java.sql.Types.BIGINT" autoIncrement="true" >
                <constraints nullable="false" primaryKey="true" />
            </column>
            <column name="created_at" type="java.sql.Types.TIMESTAMP" >
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="java.sql.Types.TIMESTAMP" >
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="java.sql.Types.TIMESTAMP" />
            <!-- START model columns -->
            <column name="parent_category_id" type="java.sql.Types.BIGINT" >
                <constraints references="t_product_category(id)" foreignKeyName="fk_t_category_parent_category_id" />
            </column>
            <column name="language_id" type="java.sql.Types.BIGINT" >
                <constraints nullable="false" references="t_language(id)" foreignKeyName="fk_t_category_language_id" />
            </column>
            <column name="code" type="java.sql.Types.VARCHAR(64)" >
                <constraints nullable="false"/>
            </column>
            <column name="name" type="java.sql.Types.VARCHAR(256)" >
                <constraints nullable="false"/>
            </column>
            <column name="description" type="java.sql.Types.VARCHAR(512)" />
            <!-- END model columns -->
        </createTable>
        <loadData file="db/changelog/changeset/0001__create_initial_tables/t_product_category.csv"
                  separator=","
                  tableName="t_product_category" />

        <createTable tableName="t_drug_rack">
            <column name="id" type="java.sql.Types.BIGINT" autoIncrement="true" >
                <constraints nullable="false" primaryKey="true" />
            </column>
            <column name="created_at" type="java.sql.Types.TIMESTAMP" >
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="java.sql.Types.TIMESTAMP" >
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="java.sql.Types.TIMESTAMP" />
            <!-- START model columns -->
            <column name="code" type="java.sql.Types.VARCHAR(64)" >
                <constraints nullable="false"/>
            </column>
            <column name="name" type="java.sql.Types.VARCHAR(256)" >
                <constraints nullable="false"/>
            </column>
            <column name="description" type="java.sql.Types.VARCHAR(512)" />
            <!-- END model columns -->
        </createTable>

        <createTable tableName="t_drug_category_base">
            <column name="id" type="java.sql.Types.BIGINT" autoIncrement="true" >
                <constraints nullable="false" primaryKey="true" />
            </column>
            <column name="created_at" type="java.sql.Types.TIMESTAMP" >
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="java.sql.Types.TIMESTAMP" >
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="java.sql.Types.TIMESTAMP" />
            <!-- START model columns -->
            <column name="code" type="java.sql.Types.VARCHAR(64)" >
                <constraints nullable="false"/>
            </column>
            <column name="name" type="java.sql.Types.VARCHAR(256)" >
                <constraints nullable="false"/>
            </column>
            <column name="description" type="java.sql.Types.VARCHAR(512)" />
            <!-- END model columns -->
        </createTable>
        <loadData file="db/changelog/changeset/0001__create_initial_tables/t_drug_category_base.csv"
                  separator=","
                  tableName="t_drug_category_base" />

        <createTable tableName="t_drug_category">
            <column name="id" type="java.sql.Types.BIGINT" autoIncrement="true" >
                <constraints nullable="false" primaryKey="true" />
            </column>
            <column name="created_at" type="java.sql.Types.TIMESTAMP" >
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="java.sql.Types.TIMESTAMP" >
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="java.sql.Types.TIMESTAMP" />
            <!-- START model columns -->
            <column name="category_base_id" type="java.sql.Types.BIGINT" >
                <constraints nullable="false" references="t_drug_category_base(id)" foreignKeyName="fk_t_drug_category_category_base_id" />
            </column>
            <column name="code" type="java.sql.Types.VARCHAR(64)" >
                <constraints nullable="false"/>
            </column>
            <column name="name" type="java.sql.Types.VARCHAR(256)" >
                <constraints nullable="false"/>
            </column>
            <column name="description" type="java.sql.Types.VARCHAR(512)" />
            <!-- END model columns -->
        </createTable>
        <loadData file="db/changelog/changeset/0001__create_initial_tables/t_drug_category.csv"
                  separator=","
                  tableName="t_drug_category" />

        <createTable tableName="t_product">
            <column name="id" type="java.sql.Types.BIGINT" autoIncrement="true" >
                <constraints nullable="false" primaryKey="true" />
            </column>
            <column name="created_at" type="java.sql.Types.TIMESTAMP" >
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="java.sql.Types.TIMESTAMP" >
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="java.sql.Types.TIMESTAMP" />
            <!-- START model columns -->
            <column name="code" type="java.sql.Types.VARCHAR(64)" >
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_t_product_code" />
            </column>
            <column name="name" type="java.sql.Types.VARCHAR(256)" />
            <column name="description" type="java.sql.Types.VARCHAR(512)" />
            <column name="quantity" type="java.sql.Types.INTEGER" defaultValue="0" />
            <column name="unit_id" type="java.sql.Types.BIGINT" >
                <constraints nullable="false" references="t_unit(id)" foreignKeyName="fk_t_product_unit_id" />
            </column>
            <column name="unit_label" type="java.sql.Types.VARCHAR(32)" />
            <column name="category_code" type="java.sql.Types.VARCHAR(64)" />
            <column name="purchase_price" type="java.sql.Types.DECIMAL" defaultValue="0" />
            <column name="selling_price" type="java.sql.Types.DECIMAL" defaultValue="0" />
            <!-- END model columns -->
        </createTable>
        <createIndex tableName="t_product" indexName="idx_t_product_code">
            <column name="code" />
        </createIndex>
        <loadData file="db/changelog/changeset/0001__create_initial_tables/t_product.csv"
                  separator=","
                  tableName="t_product" />
                  
        <createTable tableName="t_drug_detail">
            <column name="id" type="java.sql.Types.BIGINT" autoIncrement="true" >
                <constraints nullable="false" primaryKey="true" />
            </column>
            <column name="created_at" type="java.sql.Types.TIMESTAMP" >
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="java.sql.Types.TIMESTAMP" >
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="java.sql.Types.TIMESTAMP" />
            <!-- START model columns -->
            <column name="product_id" type="java.sql.Types.BIGINT" >
                <constraints nullable="false" references="t_product(id)" foreignKeyName="fk_t_drug_detail_product_id" />
            </column>
            <column name="category_id" type="java.sql.Types.BIGINT" >
                <constraints references="t_drug_category(id)" foreignKeyName="fk_t_drug_detail_category_id" />
            </column>
            <column name="category_code" type="java.sql.Types.VARCHAR(64)" />
            <column name="category_name" type="java.sql.Types.VARCHAR(256)" />
            <column name="rack_id" type="java.sql.Types.BIGINT" >
                <constraints references="t_drug_rack(id)" foreignKeyName="fk_t_drug_detail_rack_id" />
            </column>
            <column name="expired_date" type="java.sql.Types.DATE" />
            <column name="indication" type="java.sql.Types.VARCHAR(512)" />
            <column name="contraindication" type="java.sql.Types.VARCHAR(512)" />
            <column name="prescription_price" type="java.sql.Types.DECIMAL" defaultValue="0" />
            <!-- END model columns -->
        </createTable>
        <loadData file="db/changelog/changeset/0001__create_initial_tables/t_drug_detail.csv"
                  separator=","
                  tableName="t_drug_detail" />

    </changeSet>

</databaseChangeLog> 
